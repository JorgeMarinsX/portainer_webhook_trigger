# Copy to .env for local dev. JOBS is a secret: the webhook UUID is the credential.
TZ=America/Sao_Paulo
LOG_LEVEL=INFO
JOBS=[{"name":"prod-api","cron":"0 2 * * *","url":"https://portainer.example.com/api/webhooks/00000000-0000-0000-0000-000000000000"}]
# Optional, also a secret. Unset = no notifications.
# DISCORD_WEBHOOK=https://discord.com/api/webhooks/<id>/<token>

# Prod stack only (set in Portainer, not here):
# REGISTRY=registry.example.com
# IMAGE_NAME=infra/webhook-cron-trigger
